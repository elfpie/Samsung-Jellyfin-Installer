<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaXplat.Views.MainWindow"
        x:DataType="viewModels1:MainWindowViewModel"
        xmlns:viewModels1="clr-namespace:AvaloniaXplat.ViewModels"
        xmlns:views="clr-namespace:AvaloniaXplat.Views"
        SizeToContent="WidthAndHeight"
        Title="Jellyfin2Samsung"
        Background="#F5F5F5">
